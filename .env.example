# ============================================================================
#  Variables de entorno del Hub familiar de juegos
#  Copia este archivo a .env.local y rellena los valores.
#  NUNCA subas .env.local al repositorio.
# ============================================================================

# --- Neon Postgres -----------------------------------------------------------
# La integración nativa de Neon en Vercel inyecta DATABASE_URL automáticamente.
# En local, pégala desde el panel de Neon (cadena de conexión "pooled").
DATABASE_URL="postgresql://usuario:password@host/dbname?sslmode=require"

# --- Neon Auth (Better Auth) -------------------------------------------------
# Generadas por `npx neonctl@latest init` y la integración de Vercel.
NEON_AUTH_BASE_URL="https://tu-proyecto.neon-auth.app"
# Secreto para firmar/cifrar cookies de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEON_AUTH_COOKIE_SECRET="cadena-aleatoria-de-32-bytes-en-hex"

# URL pública de la app (para enlaces en correos de invitación/reset).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Data API de Neon (para los juegos externos, ver INTEGRACION-JUEGOS.md) --
# URL del endpoint PostgREST-compatible de tu proyecto Neon.
NEXT_PUBLIC_NEON_DATA_API_URL="https://app-xxxx.dataapi.neon.tech/rest/v1"

# --- SMTP (Gmail) para correos de invitación y reseteo de contraseña ---------
# En Gmail: activa 2FA y crea una "Contraseña de aplicación" (16 caracteres).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="tu-cuenta@gmail.com"
SMTP_PASS="contrasena-de-aplicacion-de-16-caracteres"
SMTP_FROM="Hub de Juegos <tu-cuenta@gmail.com>"

# --- Bootstrap del primer administrador --------------------------------------
# El script `npm run seed` marca como admin la(s) cuenta(s) con estos emails.
# Separar por comas si hay varios.
ADMIN_EMAILS="a.sotomayor.martinez@gmail.com"
